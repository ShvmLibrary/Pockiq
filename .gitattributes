# Set default behavior to automatically normalize line endings.
* text=auto

# Force LF line endings for code and configuration files.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.pro text eol=lf

# Denote binary files which should not be modified by line ending conversion.
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.apk -text
